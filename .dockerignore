# 在仓库根构建前后端（上下文均为 .）时，仅此文件生效，例如：
#   docker build -f docker/Dockerfile.skillhub-backend -t skillhub-backend:latest .
#   docker build -f docker/Dockerfile.skillhub-frontend -t skillhub-frontend:latest .
node_modules
**/node_modules
!frontend/dist
.git
.gitignore
.idea
.vscode
.cursor
**/.env
**/.env.local
**/.env.*.local

# marketplace（Python 后端源码）
marketplace/.venv
marketplace/venv
marketplace/**/__pycache__
marketplace/**/*.py[cod]
marketplace/**/*.egg-info
marketplace/.pytest_cache
marketplace/.mypy_cache
marketplace/.ruff_cache
marketplace/logs
marketplace/*.log
marketplace/data
# 排除 marketplace 下的 Markdown；保留默认隐私声明
marketplace/*.md
marketplace/**/*.md
!marketplace/privacy-statement.md

# skill-runner（独立微服务源码）
skill-runner/.venv
skill-runner/**/__pycache__
skill-runner/**/*.py[cod]

# docker images tarballs
docker-images/
