# Stage 1: Builder — use uv to build wheel
FROM python:3.11-slim-bookworm AS builder

ARG INDEX_URL=https://pypi.org/simple

RUN echo "INDEX_URL: ${INDEX_URL}"

ENV UV_INDEX_URL=${INDEX_URL}
ENV UV_DEFAULT_INDEX=${INDEX_URL}

WORKDIR /app

COPY marketplace/pyproject.toml ./
RUN pip install --no-cache-dir uv -i ${INDEX_URL} \
    --timeout=300 \
    --retries=10

COPY marketplace/ ./
RUN uv sync \
    && uv build --out-dir /app/dist

# Stage 2: Runtime — install wheel only (use slimmer image)
FROM python:3.11-slim-bookworm AS runtime

ARG INDEX_URL=https://pypi.org/simple
ARG TRUSTED_HOST=pypi.org
ARG TRUSTED_HOST_EXTRA=files.pythonhosted.org
# 可选：apt 源镜像主机名（不含协议和路径），设置后替换默认的 deb.debian.org
ARG APT_MIRROR=

RUN echo "INDEX_URL: ${INDEX_URL}"
RUN echo "TRUSTED_HOST: ${TRUSTED_HOST} ${TRUSTED_HOST_EXTRA}"
RUN echo "APT_MIRROR: ${APT_MIRROR:-<unset>}"

# Git 源同步依赖 git CLI（见 docs/Git仓库接入SkillHub设计.md）
RUN if [ -n "${APT_MIRROR}" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|${APT_MIRROR}|g" "$f"; \
      done; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /app/dist /app/data /app/logs /app/retrieval \
    && chown -R app:app /app

WORKDIR /app

COPY --from=builder /app/dist/*.whl /app/dist/

RUN pip3 install --no-cache-dir /app/dist/*.whl \
    --trusted-host ${TRUSTED_HOST} \
    --trusted-host ${TRUSTED_HOST_EXTRA} \
    --index-url ${INDEX_URL} \
    --target=/app/site-packages \
    --retries=5 \
    --timeout=120 \
    && chown -R app:app /app/site-packages

# Copy retrieval/ source separately — its internal bare imports
# (from indexing.bm25, from shared.storage, etc.) require the
# retrieval/ directory itself on sys.path, which conflicts with
# the wheel-installed retrieval package under site-packages.
COPY --from=builder /app/retrieval /app/retrieval

# 默认隐私声明 Markdown（与 Settings 默认路径 marketplace/privacy-statement.md → 构建根目录下同名文件）
COPY --from=builder /app/privacy-statement.md /app/privacy-statement.md

# Remove the wheel-installed retrieval package to avoid import conflicts
RUN rm -rf /app/site-packages/retrieval

ENV PYTHONPATH=/app/site-packages
USER app

EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request as r; r.urlopen('http://127.0.0.1:8100/api/health', timeout=2).read()"

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100"]
