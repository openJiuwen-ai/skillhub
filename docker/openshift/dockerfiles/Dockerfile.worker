# Build from the repository root. Runner creates Pods from this image.
ARG UBI_IMAGE=registry.access.redhat.com/ubi9/ubi:9.8-1793004556@sha256:48393e4261b2544f652c915b3e052256ddf66ee95cd04dc0362191f302c4e94a

FROM ${UBI_IMAGE} AS derivative-base
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TIKTOKEN_CACHE_DIR=/app/tiktoken_cache \
    HOME=/workspace \
    SKILL_RUNNER_EXECUTOR=local \
    SKILL_RUNNER_WORKSPACE_ROOT=/workspace

RUN dnf install -y python3.12 python3.12-pip git libgomp ca-certificates \
    && dnf clean all

# Keep the original Worker runtime, observability, and document tools.
RUN --mount=type=secret,id=index_url,target=/run/secrets/index_url,required=false \
    index_url="https://pypi.org/simple"; \
    if [ -s /run/secrets/index_url ]; then index_url="$(cat /run/secrets/index_url)"; fi; \
    PIP_INDEX_URL="${index_url}" python3.12 -m pip install \
        fastapi "uvicorn[standard]" httpx pydantic python-dotenv aiosqlite \
        "openjiuwen[observability]==0.1.15" \
    && python3.12 -c "import opentelemetry.sdk, opentelemetry.exporter.otlp.proto.grpc.trace_exporter, opentelemetry.exporter.otlp.proto.http.trace_exporter"
RUN --mount=type=secret,id=index_url,target=/run/secrets/index_url,required=false \
    index_url="https://pypi.org/simple"; \
    if [ -s /run/secrets/index_url ]; then index_url="$(cat /run/secrets/index_url)"; fi; \
    PIP_INDEX_URL="${index_url}" python3.12 -m pip install \
        pyarrow "scikit-learn>=1.0" scipy matplotlib tabulate python-pptx jieba

# Keep the original preloaded vocabularies for the first LLM request.
RUN mkdir -p /app/tiktoken_cache \
    && python3.12 -c "import tiktoken; [tiktoken.get_encoding(n) for n in ('cl100k_base','o200k_base')]"

COPY skill-runner/ /app/skill_runner/
COPY docker/skill-agent-worker/entrypoint.sh /entrypoint.sh
RUN mkdir -p /workspace \
    && chgrp -R 0 /workspace /app/tiktoken_cache \
    && chmod -R g=u /workspace /app/tiktoken_cache \
    && chmod 755 /entrypoint.sh

WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["/entrypoint.sh"]

FROM derivative-base AS runtime
USER 10001:0
